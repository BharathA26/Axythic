Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical production host. Preview and local hostnames are left unchanged.
  RewriteCond %{HTTP_HOST} ^www\.axythic\.com$ [NC]
  RewriteRule ^ https://axythic.com%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^axythic\.com$ [NC]
  RewriteRule ^ https://axythic.com%{REQUEST_URI} [R=301,L,NE]

  # Serve real assets directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Only declared SPA routes receive the application shell.
  RewriteRule ^$ index.html [L]
  RewriteRule ^(?:privacy-policy|terms|axythicfin/dashboard|shopcart|portfolio|fitness-app|eduquest(?:/(?:student(?:/(?:courses|inbox|tasks|team|settings|plan|help))?|courses|admin))?|hrm/(?:dashboard|personnel|profile|applications|talent|events|settings))/?$ index.html [L]

  # Unknown paths must remain real HTTP 404 responses.
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(axythicfin|shopcart|portfolio|fitness-app|eduquest|hrm)(/|$)" AXYTHIC_NOINDEX
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://axythicbackend.vercel.app; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; img-src 'self' data: https://images.unsplash.com https://i.pravatar.cc https://ui-avatars.com https://placehold.co https://cdn.simpleicons.org; manifest-src 'self'; media-src 'self'; object-src 'none'; script-src 'self' 'sha256-/yyy1nSH2410x1J6ZjFex5gaiRgpYjGRL3mSm27g+3g='; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; worker-src 'none'; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always unset X-Powered-By
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=AXYTHIC_NOINDEX
</IfModule>
